<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimpleZipDrive.Views.MessageBoxWindow"
        Title="Simple Zip Drive"
        SizeToContent="WidthAndHeight"
        MinWidth="340"
        MaxWidth="620"
        CanResize="False"
        ShowInTaskbar="False"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto" ToolTip.Tip="Message box layout">
        <StackPanel Orientation="Horizontal" Spacing="14" ToolTip.Tip="Message content">
            <TextBlock x:Name="IconText"
                       FontSize="26"
                       VerticalAlignment="Top"
                       Text=""
                       ToolTip.Tip="Message icon" />
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       MaxWidth="500"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       ToolTip.Tip="Message text" />
        </StackPanel>

        <StackPanel x:Name="ButtonsPanel"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"
                    Spacing="10"
                    ToolTip.Tip="Dialog buttons" />
    </Grid>
</Window>
