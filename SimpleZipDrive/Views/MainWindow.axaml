<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimpleZipDrive.Views.MainWindow"
        Title="Simple Zip Drive"
        Height="600"
        Width="800"
        MinHeight="400"
        MinWidth="500"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        WindowStartupLocation="CenterScreen"
        Closing="MainWindow_Closing"
        KeyDown="Window_KeyDown">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top Menu -->
        <Menu Grid.Row="0">
            <MenuItem Header="File" ToolTip.Tip="File operations">
                <MenuItem Header="Mount as Drive Letter..." Click="MountAsDrive_ClickAsync"
                          ToolTip.Tip="Select an archive and mount as a virtual drive letter" />
                <MenuItem Header="Mount as Folder..." Click="MountAsFolder_ClickAsync"
                          ToolTip.Tip="Select an archive and mount as a folder" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" InputGesture="Alt+F4"
                          ToolTip.Tip="Close the application" />
            </MenuItem>
            <MenuItem Header="Settings" ToolTip.Tip="Application settings">
                <MenuItem Header="Settings..." Click="SettingsRamLimit_Click" InputGesture="Ctrl+R"
                          ToolTip.Tip="Application settings" />
                <Separator />
                <MenuItem Header="Open Configuration Path" Click="OpenConfigPath_Click"
                          ToolTip.Tip="Open the folder where settings are stored" />
                <MenuItem Header="Clean Temp Files" Click="CleanTempFiles_Click"
                          ToolTip.Tip="Clean temporary cache files from previous sessions" />
            </MenuItem>
            <MenuItem Header="Help" ToolTip.Tip="Help and information">
                <MenuItem Header="About" Click="About_Click" InputGesture="F1"
                          ToolTip.Tip="View application information and credits" />
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15" RowDefinitions="Auto,*">
            <!-- Toolbar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="3,3,0,0"
                    Padding="10,8"
                    Margin="0,0,0,-1"
                    ToolTip.Tip="Toolbar with mount controls and log actions">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="MountButton"
                            Content="Mount"
                            Click="Mount_ClickAsync"
                            Width="90"
                            Theme="{StaticResource PrimaryButton}"
                            ToolTip.Tip="Select a ZIP, 7Z, RAR, TAR, ZAR, or XISO file to mount" />

                    <Button x:Name="UnmountButton"
                            Content="Unmount"
                            Click="Unmount_ClickAsync"
                            Width="90"
                            IsEnabled="False"
                            Theme="{StaticResource PrimaryButton}"
                            ToolTip.Tip="Unmount the currently mounted drive" />

                    <Rectangle Width="1"
                               Fill="{StaticResource BorderPrimaryBrush}"
                               Margin="8,2,8,2"
                               ToolTip.Tip="Separates mount actions from log actions" />

                    <Button Content="Copy All" Click="CopyLog_Click" Width="90"
                            Theme="{StaticResource SecondaryButton}"
                            ToolTip.Tip="Copy all log entries to clipboard" />
                    <Button Content="Clear Log" Click="ClearLog_Click" Width="90"
                            Theme="{StaticResource SecondaryButton}"
                            ToolTip.Tip="Clear all log entries" />
                </StackPanel>
            </Border>

            <!-- Log Section -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgPrimaryBrush}"
                    BorderBrush="{StaticResource BorderPrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,3,3"
                    ToolTip.Tip="Log output area - shows mount activity, errors, and status messages">
                <TextBox x:Name="LogTextBox"
                         Classes="log"
                         ToolTip.Tip="Application log output. Right-click for options.">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="CopySelection_Click" />
                            <MenuItem Header="Copy All" Click="CopyLog_Click" />
                            <Separator />
                            <MenuItem Header="Clear Log" Click="ClearLog_Click" />
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{StaticResource AccentPrimaryBrush}"
                ToolTip.Tip="Application status bar">
            <Grid Margin="10,4" ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Ready"
                           Foreground="White"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Current application status" />
                <TextBlock x:Name="MountStatusText"
                           Grid.Column="2"
                           Text=""
                           Foreground="White"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Current mount status and location" />
            </Grid>
        </Border>
    </Grid>
</Window>
