<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <ApplicationIcon>icon\zip.ico</ApplicationIcon>
        <IsPackable>false</IsPackable>
        <AssemblyVersion>3.1.0</AssemblyVersion>
        <FileVersion>3.1.0</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <Company>PureLogicCode.com</Company>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Single-file publish settings -->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SimpleZipDrive.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="DokanNet" Version="2.3.0.3" />
        <PackageReference Include="winfsp.net" Version="2.1.25156" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SharpCompress" Version="0.50.4" />
        <PackageReference Include="XISOSharp" Version="1.4.2" />
        <PackageReference Include="ZArchiveSharp" Version="1.4.0" />
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.294">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Remove="References\**" />
    </ItemGroup>

    <ItemGroup>
        <!-- Shown in the About window; embedded so it works from the single-file bundle. -->
        <AvaloniaResource Include="icon\zip.png" />
    </ItemGroup>

    <!--
        The 7-Zip fallback extractor runs a command-line executable instead of loading a native
        library, so the shipped binary must match the target platform. Each publish/build drops
        exactly the binary for its RuntimeIdentifier next to the app:
        - Windows: 7za.exe (standalone console build)
        - Linux:   7zzs (statically linked console build, maximum distro portability)
        - macOS:   7zz (universal x86-64/arm64 console build)
        Sources: https://github.com/ip7z/7zip (26.03). See 7zip/License.txt.
    -->
    <ItemGroup>
        <None Update="7zip\win-x64\7za.exe" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
            <Link>7za.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="7zip\win-arm64\7za.exe" Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
            <Link>7za.exe</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="7zip\linux-x64\7zzs" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
            <Link>7zzs</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="7zip\linux-arm64\7zzs" Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
            <Link>7zzs</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="7zip\osx\7zz" Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
            <Link>7zz</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="7zip\License.txt">
            <Link>7zip-license.txt</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="References\**" />
        <AvaloniaXaml Remove="References\**" />
    </ItemGroup>

    <!--
        winfsp-msil's static initializer calls FileVersionInfo.GetVersionInfo(Assembly.Location);
        inside a single-file bundle Assembly.Location is empty, which kills every mount with
        "The path is empty. (Parameter 'path')". Keep the interop assembly loose beside the exe
        on Windows; it is Windows-only, so drop it from Linux/macOS publish output entirely.
    -->
    <Target Name="KeepWinFspInteropOutOfBundle" BeforeTargets="_ComputeFilesToBundle">
        <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                                   Condition="'%(Filename)' == 'winfsp-msil'">
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
        <ItemGroup Condition="!$(RuntimeIdentifier.StartsWith('win'))">
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                                   Condition="'%(Filename)' == 'winfsp-msil'" />
        </ItemGroup>
    </Target>

</Project>
