<Project>

    <PropertyGroup>
        <!-- Central Package Management: every package version is pinned in one place. -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Exact (bracketed) versions keep restores reproducible and satisfy the
             OpenSSF Scorecard Pinned-Dependencies check. -->
        <PackageVersion Include="Avalonia" Version="[12.1.6]" />
        <PackageVersion Include="Avalonia.Desktop" Version="[12.1.6]" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="[12.1.6]" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="[12.1.6]" />
        <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="[2.2.3]" />
        <PackageVersion Include="coverlet.collector" Version="[10.1.0]" />
        <PackageVersion Include="DokanNet" Version="[2.3.0.3]" />
        <PackageVersion Include="FsCheck.Xunit" Version="[3.6.0]" />
        <PackageVersion Include="Meziantou.Analyzer" Version="[3.0.322]" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="[18.11.0]" />
        <PackageVersion Include="Roslynator.Analyzers" Version="[5.0.1]" />
        <PackageVersion Include="Serilog" Version="[4.4.0]" />
        <PackageVersion Include="Serilog.Sinks.Debug" Version="[3.0.0]" />
        <PackageVersion Include="Serilog.Sinks.File" Version="[7.0.0]" />
        <PackageVersion Include="SharpCompress" Version="[0.50.8]" />
        <!-- winfsp.net 2.2.x rejects the stable native WinFsp 2.1 driver at runtime
             ("incorrect dll version (need 2.2, have 2.1)"); keep the 2.1 interop. -->
        <PackageVersion Include="winfsp.net" Version="[2.1.25156]" />
        <PackageVersion Include="XISOSharp" Version="[1.9.1]" />
        <PackageVersion Include="xunit" Version="[2.9.3]" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="[4.0.1]" />
        <PackageVersion Include="ZArchiveSharp" Version="[1.4.0]" />
    </ItemGroup>

</Project>
