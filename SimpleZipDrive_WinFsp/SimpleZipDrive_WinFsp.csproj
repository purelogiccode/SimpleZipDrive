<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyVersion>2.9.0</AssemblyVersion>
        <FileVersion>2.9.0</FileVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <ApplicationIcon>icon\zip.ico</ApplicationIcon>
        <IsPackable>false</IsPackable>
        <Company>PureLogicCode.com</Company>
        <NeutralLanguage>en</NeutralLanguage>
        <!-- Single-file publish settings. The native 7z.dll / 7z_arm64.dll fallback libraries
             must stay as real files beside the executable: SevenZipFallback probes
             AppContext.BaseDirectory for them, so they must not be bundled into the exe. -->
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <Target Name="KeepWinFspInteropOutOfBundle" BeforeTargets="_ComputeFilesToBundle">
        <!-- winfsp-msil's static initializer (Fsp.Interop.Api.CheckVersion) calls
             FileVersionInfo.GetVersionInfo(Assembly.GetExecutingAssembly().Location), and
             Assembly.Location is an empty string for assemblies bundled inside a single-file
             executable (Path.GetFullPath("") throws, killing every mount with
             "The path is empty. (Parameter 'path')"). Shipping winfsp-msil.dll as a real file
             beside the exe keeps the interop version check functional. -->
        <ItemGroup>
            <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                                   Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'winfsp-msil.dll'"
                                   ExcludeFromSingleFile="true" />
        </ItemGroup>
    </Target>
    <ItemGroup>
        <InternalsVisibleTo Include="SimpleZipDrive.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleZipDrive.Core\SimpleZipDrive.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="References\**" />
        <None Update="7z.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="7z_arm64.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>

    </ItemGroup>

    <ItemGroup>
        <Compile Remove="References\**" />
    </ItemGroup>

    <ItemGroup>
        <Page Remove="References\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.231">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SharpCompress" Version="0.50.4" />
        <!-- winfsp.net 2.1.x is built against the latest STABLE WinFsp release (2.1.25156).
             The interop version check accepts any native WinFsp with matching major version
             (2) and minor >= the interop's minor, so 2.1 interop supports native 2.1 (stable)
             and 2.2+ (beta). Newer winfsp.net 2.2.x packages reject the stable native 2.1
             driver with "incorrect dll version (need 2.2, have 2.1)". -->
        <PackageReference Include="winfsp.net" Version="2.1.25156" />
    </ItemGroup>
</Project>